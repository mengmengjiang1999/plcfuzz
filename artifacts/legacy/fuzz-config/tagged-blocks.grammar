# Archived tagged-block grammar; incompatible with the active plain numeric serializer.
start         = bigblocks
bigblocks     = bigblock | bigblocks bigblock
bigblock      = "[BIGBLOCK]" blocks "[ENDBLOCK]"
blocks        = bool_block byte_block int_block dint_block lint_block int_mem_block dint_mem_block
bool_block        = "[bool_block]" header 64_w8numbers
byte_block        = "[byte_block]" header 8_w8numbers
int_block        = "[int_block]" header 8_w16numbers
dint_block        = "[dint_block]" header 8_w32numbers
lint_block        = "[lint_block]" header 8_w64numbers
int_mem_block        = "[int_mem_block]" header 8_w16numbers
dint_mem_block        = "[dint_mem_block]" header 8_w32numbers
header        = number_1_10000
64_w8numbers     = {64} number_0_w8
8_w8numbers      = {8} number_0_w8 
8_w16numbers     = {8} number_0_w16
8_w32numbers     = {8} number_0_w32 
8_w64numbers     = {8} number_0_w64
number_1_10000 = "1" | "2" | ... | "10000"
number_0_w8  = "0" | "1" | ... | "255"
number_0_w32 = "0" | "1" | ... | "4294967295"
number_0_w16 = "0" | "1" | ... | "65535"
number_0_w64 = "0" | "1" | ... | "18446744073709551615"
