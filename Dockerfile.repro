ARG BASE_IMAGE=public.ecr.aws/ubuntu/ubuntu:22.04@sha256:23bda685bd84a4d3b9caf2086a4c35f368bb7acd57ef38090b7a45ac92216ccf
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

ARG DEBIAN_FRONTEND=noninteractive
ARG OPENPLC_COMMIT=091524e1d80120cbe6b2c130822e91369f12eccd
ARG AFLPP_TAG=v5.03c

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        autoconf \
        automake \
        bison \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        flex \
        git \
        libtool \
        llvm-dev \
        lld \
        pkg-config \
        python3 \
        strace

# Keep the exact upstream source trees in the image. Besides making rebuilds
# auditable, this preserves the corresponding source and license texts for the
# GPL/LGPL components installed below.
RUN git clone https://github.com/thiagoralves/OpenPLC_v3.git /opt/upstream/OpenPLC_v3 \
    && git -C /opt/upstream/OpenPLC_v3 checkout "${OPENPLC_COMMIT}" \
    && cmake -S /opt/upstream/OpenPLC_v3/utils/dnp3_src \
             -B /opt/upstream/OpenPLC_v3/utils/dnp3_src/build \
    && cmake --build /opt/upstream/OpenPLC_v3/utils/dnp3_src/build --parallel \
    && cmake --install /opt/upstream/OpenPLC_v3/utils/dnp3_src/build \
    && cd /opt/upstream/OpenPLC_v3/utils/libmodbus_src \
    && ./autogen.sh \
    && ./configure \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig

RUN git clone --branch "${AFLPP_TAG}" --depth 1 \
        https://github.com/AFLplusplus/AFLplusplus.git /opt/upstream/AFLplusplus \
    && make -C /opt/upstream/AFLplusplus source-only -j1 \
    && make -C /opt/upstream/AFLplusplus install

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends ripgrep

ARG SOURCE_REVISION
ARG MATIEC_REVISION

COPY . /workspace/plc-lab
WORKDIR /workspace/plc-lab

ENV PLC_LAB_BASE_IMAGE=${BASE_IMAGE} \
    PLC_LAB_SOURCE_REVISION=${SOURCE_REVISION} \
    PLC_LAB_MATIEC_REVISION=${MATIEC_REVISION}

RUN mkdir -p /opt/plc-lab-acceptance \
    && ./scripts/run_linux_acceptance.sh /opt/plc-lab-acceptance/report.json

CMD ["/bin/bash"]
