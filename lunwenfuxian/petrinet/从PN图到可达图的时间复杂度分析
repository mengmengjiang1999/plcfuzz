    while queue:  # O(N)循环
        # 获取使能变迁 - O(T × P)
        sensing_transitions = self.get_enabled_transitions(...)  
        
        for trans in sensing_transitions:  # O(b1)
            # 触发变迁 - O(P)
            new_marking = self.fire_transition(...)  
            
            # 检查状态存在性 - O(N × P)
            if not self.is_marking_in_list(...):  
                self.nodes.append(...)  # O(1)
主要瓶颈在is_marking_in_list的状态检查（O(N × P)）
4. 优化建议
(1) 哈希表优化
def __init__(self):
    self.marking_hashes = set()  # 新增哈希集合

def is_marking_in_list(self, marking):
    return self.hash_marking(marking) in self.marking_hashes  # O(1)
将状态检查从O(N×P)降至O(1)
(2) 并行化处理
from concurrent.futures import ThreadPoolExecutor

def fire_transition_parallel(transitions, marking):
    with ThreadPoolExecutor() as executor:
        return list(executor.map(self.fire_transition, transitions, [marking]*len(transitions)))
(3) 状态压缩
def hash_marking(self, marking):
    # 使用位压缩表示状态
    return sum(1 << i for i, (k,v) in enumerate(marking.items()) if v > 0)
